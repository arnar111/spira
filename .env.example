# Anthropic Claude API key for the plant-health advisor (/api/diagnose).
# Set this in Netlify → Site settings → Environment variables. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-4-8).
# For lower cost/latency you can switch to claude-sonnet-4-6 or claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8
